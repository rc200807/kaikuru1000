generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ライセンスキー（本部が事前登録）
model LicenseKey {
  id        String   @id @default(cuid())
  key       String   @unique
  isUsed    Boolean  @default(false)
  startDate DateTime? // ライセンス利用開始日
  endDate   DateTime? // ライセンス利用終了日（未終了は null）
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?
}

// 顧客ユーザー
model User {
  id             String    @id @default(cuid())
  name           String
  furigana       String
  lastName       String?   // 姓（分割入力。結合値 name が正データ）
  firstName      String?   // 名
  lastNameKana   String?   // 姓ふりがな
  firstNameKana  String?   // 名ふりがな
  email          String?   @unique
  phone          String
  phone2         String?   // 追加連絡先 1（任意）
  phone3         String?   // 追加連絡先 2（任意）
  address        String
  birthDate      String?             // 生年月日（顧客プロフィール。身分証OCRから選択反映）
  internalNote   String?   @db.Text  // 店舗・管理者のみ閲覧可能な内部メモ（顧客には非公開）
  mergedIntoUserId String?           // 顧客統合で吸収された場合の統合先User.id（論理削除の目印）
  mergedAt         DateTime?         // 統合された日時
  password       String
  licenseKeyId   String?   @unique
  licenseKey     LicenseKey? @relation(fields: [licenseKeyId], references: [id])
  idDocumentPath  String?   @db.Text  // 身分証明書ファイルURL（Vercel Blob）
  idDocumentUploadedAt DateTime?    // 身分証アップロード日時（4日後に画像自動削除）
  // 身分証OCR抽出フィールド（Gemini Vision）
  idDocumentType  String?             // 書類種別（運転免許証/パスポート/マイナンバーカードなど）
  idName          String?             // 身分証記載氏名
  idBirthDate     String?             // 生年月日（YYYY-MM-DD または 和暦テキスト）
  idAddress       String?   @db.Text  // 身分証記載住所
  idLicenseNumber String?             // 免許番号・旅券番号など
  idExpiryDate    String?             // 有効期限（YYYY-MM-DD または テキスト）
  idOcrIssueReport String?  @db.Text  // 顧客によるOCR誤り報告
  idDocumentBackPath  String?  @db.Text  // 身分証裏面ファイルURL
  idBackAddress       String?            // 裏面記載の新住所
  idFacePhotoPath     String?  @db.Text  // 顔写真抽出画像URL
  selfieImagePath     String?  @db.Text  // セルフィー画像URL（本人確認用）
  faceVerificationResult String?         // 顔照合結果（JSON文字列）
  faceVerificationAt  DateTime?          // 顔照合実行日時
  // 住所確認関連
  addressVerified       Boolean  @default(false)  // 住所確認済み（管理者が承認）
  addressMismatch       Boolean  @default(false)  // 住所不一致フラグ
  proofDocumentPath     String?  @db.Text          // 住所証明書類URL
  proofDocumentType     String?                     // 書類種別
  proofDocumentStatus   String?                     // pending/approved/rejected
  storeId        String?   // 担当店舗ID（本部が割り当て）
  store          Store?    @relation(fields: [storeId], references: [id])
  isActive       Boolean   @default(true)
  // 顧客タイプ
  customerType          String    @default("visit")  // 主たる種別: "visit" | "delivery" | "regular" | "akikuru"
  customerTypes         String    @default("[]")      // JSON配列: 顧客に適用する全種別（複数可）
  visitFrequencyMonths  Int       @default(1)         // 訪問・宅配の頻度（何ヶ月に1回）
  occupation            String?                       // 職業（売買契約書作成時に取得）
  leadSource            String?                       // 流入経路（LeadSourceマスタの名称を格納）
  // 振込先口座情報
  bankName       String?
  branchName     String?
  accountType    String?   // "普通" | "当座"
  accountNumber  String?
  accountHolder  String?
  visitSchedules VisitSchedule[]
  visitRequests     VisitRequest[]
  purchaseMemos     PurchaseMemo[]
  deliveryShipments DeliveryShipment[]
  magicLinks        MagicLink[]
  inquiries         Inquiry[]
  lineUsers         LineUser[]
  formSubmissions   FormSubmission[]
  partnerNotes      SalesPartnerCustomerNote[]
  deals             Deal[]
  trackingVisitors  TrackingVisitor[]
  akiyaCases        AkiyaCase[]
  stripeCustomerId  String?   @unique  // アキクル請求用のStripe Customer ID（cus_...）
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// 店舗
model Store {
  id         String   @id @default(cuid())
  name       String   // 店舗名
  code       String   @unique // 店舗コード
  phone      String?
  postalCode String?  // 郵便番号
  address    String?
  prefecture String?  // 都道府県
  lat        Float?   // 緯度（住所からジオコーディングしてキャッシュ）
  lng        Float?   // 経度（同上）
  email      String?
  contractNotifyEmail String? // 契約作成通知の送信先（未設定時は email を使用）
  calendarInviteEmail String? // 訪問スケジュール追加時のGoogleカレンダー招待送信先
  password   String
  avatar     String?  @db.Text  // プロフィール画像URL（Vercel Blob）
  sheetRowId String?  // Googleスプレッドシートの行ID（同期用）
  isActive   Boolean  @default(true)
  // 店舗詳細情報
  storeStatus         String?   @default("active")  // "active" or "closed"
  openingDate         DateTime? // 開業日
  closingDate         DateTime? // 閉店日
  googleBusinessUrl   String?   // Googleビジネスプロフィール URL
  oikuraPageUrl       String?   // おいくらページ URL
  lineAddFriendUrl    String?   // LINE友達登録リンク（URL）
  bankInfo            String?   @db.Text  // 銀行情報（レガシー自由記述。新規登録は下記の構造化フィールドを使用）
  // 銀行口座情報（全銀データ検索で入力。User/Operatorモデルと同じ構成）
  bankName            String?
  branchName          String?
  accountType         String?   // "普通" | "当座"
  accountNumber       String?
  accountHolder       String?
  invoiceNumber       String?   // インボイス番号
  antiquePermitNumber String?   // 古物営業許可番号
  lockPin             String?   // 画面ロック暗証番号（4〜6桁）
  businessHoursStart  String?   @default("10:00") // 営業開始時間
  businessHoursEnd    String?   @default("19:00") // 営業終了時間
  businessDays        String?   @default("[0,1,2,3,4,5,6]") // 営業曜日 JSON配列 (0=日,1=月,...6=土)
  // 店舗別問い合わせ記録シート
  inquirySpreadsheetId      String?               // 発行済みスプレッドシートID
  inquirySheetUrl           String?  @db.Text     // 共有用URL
  inquirySheetSharedEmails  String?  @db.Text     // JSON配列: 共有許可済みのメールアドレス
  inquirySheetIssuedAt      DateTime?             // 発行日時
  // 対応エリア（出張買取などの対応可能地域）。JSON: [{ prefecture: string, cities: string[] }]
  serviceAreas              String?  @default("[]") @db.Text
  // 対応サービス（複数選択）。JSON配列: ["kaikuru","akikuru"]（Operator.supportedServices と同形式）
  supportedServices         String   @default("[]")
  // Stripe Connect（アキクル請求の分配受取用）
  stripeConnectAccountId      String?   @unique              // Connect Express アカウント（acct_...）
  stripeConnectStatus         String    @default("none")     // none | onboarding | active | restricted
  stripeConnectChargesEnabled Boolean   @default(false)      // account.updated webhook で同期
  stripeConnectPayoutsEnabled Boolean   @default(false)
  stripeConnectOnboardedAt    DateTime?
  // 店舗の支払い用 Stripe Customer（システム利用料・今後の店舗決済すべて）
  stripeCustomerId            String?   @unique              // cus_...
  systemFeeSetting            SystemFeeSetting?
  storePayments               StorePayment[]
  customers  User[]
  visitSchedules VisitSchedule[]
  visitRequests  VisitRequest[]
  members    StoreMember[]
  communityThreads   CommunityThread[]
  communityReplies   CommunityReply[]
  communityReactions CommunityReaction[]
  chatRoom           ChatRoom?
  googleCalendar StoreGoogleCalendar?
  storeLinksFrom StoreLink[] @relation("StoreLinkFrom")
  storeLinksTo   StoreLink[] @relation("StoreLinkTo")
  announcementReads AnnouncementRead[]
  inquiries  Inquiry[]
  bugReports BugReport[]
  lineChannels LineChannel[]
  formsAsCustomerStore Form[]   @relation("FormCustomerStore")
  trainingVideoViews   TrainingVideoView[]
  deals      Deal[]
  inventoryItems InventoryItem[]
  akiyaCases AkiyaCase[]
  akikuruInvoices AkikuruInvoice[]
  // 運営者（複数店舗を1運営者が運営できる）
  operatorId String?
  operator   Operator? @relation(fields: [operatorId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([operatorId])
}

// 運営者情報（法人・個人事業主）
model Operator {
  id                       String   @id @default(cuid())
  // 会社形態
  entityType               String                              // "corporation" | "sole_proprietor"
  corporatePrefix          String?                             // 法人種別（分類用。"株式会社"等の文字は name に含めて入力する）
  name                     String                              // 法人名（"株式会社○○"などプレフィックス込みのフルネーム）or 屋号
  address                  String?                             // 所在地
  representativeName       String                              // 代表者氏名
  representativeNameKana   String?                             // 代表者氏名（フリガナ）
  corporateNumber          String?                             // 法人番号（13桁）
  invoiceRegistered        Boolean  @default(false)
  invoiceNumber            String?                             // 適格請求書発行事業者登録番号（T+13桁）
  phone                    String?
  email                    String?
  contractFilePath         String?                             // 契約書PDF（Vercel Blob URL）
  contractFileUploadedAt   DateTime?
  // 古物営業
  antiquePermitNumber      String?                             // 古物営業許可番号
  antiqueOfficeAddress     String?                             // 古物営業所住所
  antiqueLicenseHolder     String?                             // 古物営業法届出名義
  publicSafetyCommission   String?                             // 管轄公安委員会
  service                  String?  @db.Text                   // 運営サービス（自由記述）
  supportedServices        String   @default("[]")             // 対応サービス（複数選択。JSON配列: ["kaikuru","akikuru"]）
  // 銀行口座情報（全銀データ検索で入力。User モデルと同じ構成）
  bankName                 String?
  branchName               String?
  accountType              String?                             // "普通" | "当座"
  accountNumber            String?
  accountHolder            String?
  stores                   Store[]
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

// 店舗Googleカレンダー連携設定
model StoreGoogleCalendar {
  id              String    @id @default(cuid())
  storeId         String    @unique
  store           Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  googleEmail     String?
  accessToken     String?   @db.Text  // AES-256-GCM encrypted
  refreshToken    String?   @db.Text  // AES-256-GCM encrypted
  tokenExpiry     DateTime?
  calendarId      String    @default("primary")  // Which calendar to sync to
  calendarName    String?   // Display name of selected calendar
  isEnabled       Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// 店舗アカウントリンク（複数店舗の切り替え用）
model StoreLink {
  id            String   @id @default(cuid())
  storeId       String   // リンク元の店舗
  store         Store    @relation("StoreLinkFrom", fields: [storeId], references: [id], onDelete: Cascade)
  linkedStoreId String   // リンク先の店舗
  linkedStore   Store    @relation("StoreLinkTo", fields: [linkedStoreId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@unique([storeId, linkedStoreId])
  @@index([storeId])
  @@index([linkedStoreId])
}

// 店舗メンバー（店舗のサブアカウント）
model StoreMember {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  name      String
  email     String
  password  String
  avatar    String?  @db.Text  // プロフィール画像URL（Vercel Blob）
  orgRole   String?  // 'admin' = 組織管理者（運営者配下の複数店舗を横断管理できる）。null = 権限なし
  // 行動帰属（メンバーが担当・作成したレコード）
  visitSchedules VisitSchedule[]
  deals          Deal[]
  estimates      Estimate[]
  accessLogs     AccessLog[]
  chatMessages   ChatMessage[]
  akiyaCases     AkiyaCase[]
  akiyaRecords   AkiyaRecord[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, email]) // 同一店舗内でのみメール一意
}

// 訪問スケジュール
model VisitSchedule {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  storeId        String
  store          Store    @relation(fields: [storeId], references: [id])
  visitDate      DateTime
  startTime      String?  // "HH:mm" 形式（例: "10:00"）
  endTime        String?  // "HH:mm" 形式（例: "11:30"）
  status         String   @default("scheduled") // scheduled, completed, cancelled
  note           String?
  purchaseAmount Int?     // 買取金額（円）— 品目合計から自動計算
  billingAmount  Int?     // 請求金額（円）— 作業品目合計から自動計算
  googleCalendarEventId String?
  preConsentSignature   String?  @db.Text  // 事前同意の署名画像（base64）
  preConsentAt          DateTime?           // 事前同意日時
  staffName             String?             // 担当者名
  memberId              String?             // 担当した店舗メンバー（帰属。staffName はスナップショットとして併存）
  member                StoreMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  revisitDate           DateTime?           // 再訪問予定日
  revisitStart          String?             // 再訪問開始時間 (HH:MM)
  revisitEnd            String?             // 再訪問終了時間 (HH:MM)
  revisitNote           String?             // 再訪問メモ
  supplementaryDocs     String?  @db.Text   // 補足確認書類（チェックした書類名のJSON配列）
  purchaseItems  PurchaseItem[]
  workItems      WorkItem[]
  salesContract  SalesContract?
  estimate       Estimate?
  dealId         String?
  deal           Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([dealId])
  @@index([memberId])
}

// 訪問ステータス（管理ポータルから管理）
model VisitStatus {
  id        String   @id @default(cuid())
  key       String   @unique  // e.g. "scheduled", "completed", etc.
  label     String            // Japanese display label
  color     String   @default("#6B7280")  // hex color for badge
  sortOrder Int      @default(0)
  isDefault Boolean  @default(false)  // default status for new visits
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 買取品目カテゴリ（管理ポータルから管理）
model PurchaseCategory {
  id            String         @id @default(cuid())
  name          String         @unique
  sortOrder     Int            @default(0)
  purchaseItems PurchaseItem[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

// 流入経路マスタ（管理ポータルから管理。電話/お問い合わせフォーム/LINE/紹介/おいくら など）
model LeadSource {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 買取品目（訪問ごとに記録する買取商品）
model PurchaseItem {
  id              String        @id @default(cuid())
  visitScheduleId String?
  visitSchedule   VisitSchedule? @relation(fields: [visitScheduleId], references: [id], onDelete: SetNull)
  dealId          String?                     // 案件への紐づけ（再ペアレント。これが正）
  deal            Deal?         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  itemName        String                      // 品名
  category        String                      // カテゴリー名（表示用）
  categoryId      String?                     // PurchaseCategoryへの参照
  purchaseCategory PurchaseCategory? @relation(fields: [categoryId], references: [id])
  imageUrls       String   @default("[]")   // JSON配列: 画像URL[] (最大3枚)
  quantity        Int      @default(1)        // 数量
  purchasePrice   Int      @default(0)        // 買取金額（円）
  janCode         String?                     // JANコード（バーコード）
  rakutenData     String?  @db.Text           // 楽天商品検索APIの結果 (JSON文字列)
  aiResearch      String?                     // AI市場調査結果 (JSON文字列)
  aiResearchedAt  DateTime?                   // AI調査実行日時
  isAdditionalRequest Boolean @default(false) // 追加依頼品タグ
  notes           String?  @db.Text           // 備考
  inventoryItem   InventoryItem?              // 変換先の在庫（1:1。未変換は null）
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([visitScheduleId])
  @@index([dealId])
}

// 作業品目（案件ごとの請求作業）
model WorkItem {
  id              String        @id @default(cuid())
  visitScheduleId String?
  visitSchedule   VisitSchedule? @relation(fields: [visitScheduleId], references: [id], onDelete: SetNull)
  dealId          String?                     // 案件への紐づけ（再ペアレント。これが正）
  deal            Deal?         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  workName        String                      // 作業名
  unitPrice       Int      @default(0)        // 単価（円）
  quantity        Int      @default(1)        // 数量
  notes           String?  @db.Text           // 備考
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([visitScheduleId])
  @@index([dealId])
}

// 管理者
model Admin {
  id            String         @id @default(cuid())
  name          String
  email         String?                           // 一意制約なし：同一メールで管理ポータルとシステム管理者を別々に持てる。idpass方式はnull
  loginId       String?        @unique             // ID+パスワード方式のログインID（メールなし管理者用）
  password      String
  role          String         @default("admin") // admin, superadmin, hr, sysadmin
  authMethod    String         @default("email")  // "email"（従来のメール招待）| "idpass"（ID+パスワード方式）
  status        String         @default("active")  // "active" | "pending_passkey" | "pending_approval"（idpassのみpending_*を使う）
  approvedById  String?                            // 承認したsuperadminのAdmin.id
  approvedAt    DateTime?                          // 承認日時
  avatar        String?        @db.Text  // プロフィール画像URL（Vercel Blob）
  announcements  Announcement[]
  releaseNotes   ReleaseNote[]  @relation("ReleaseNoteAuthor")
  trainingVideos TrainingVideo[]
  forms          Form[]
  invitedPartners SalesPartner[]           @relation("SalesPartnerInvitedBy")
  partnerInvitationsCreated SalesPartnerInvitation[] @relation("SalesPartnerInvCreatedBy")
  linkPartnersCreated LinkPartner[]        @relation("LinkPartnerCreatedByAdmin")
  chatMessages   ChatMessage[]
  createdAt      DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

// Googleスプレッドシート同期ログ
model SyncLog {
  id       String   @id @default(cuid())
  type     String   // stores, licenses
  status   String   // success, error
  message  String?  
  syncedAt DateTime @default(now())
}

// メール送信設定（SMTP）
model EmailConfig {
  id          String   @id @default(cuid())
  smtpHost    String   @default("")
  smtpPort    Int      @default(587)
  smtpUser    String   @default("")
  smtpPass    String   @default("")   // AES-256-GCM 暗号化済み
  fromAddress String   @default("")
  fromName    String   @default("買いクル 本部")
  enabled     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Google Sheets 連携設定（OAuth2トークン + スプレッドシート設定）
model GoogleSheetsConfig {
  id                  String    @id @default(cuid())
  googleEmail         String?
  accessToken         String?     // AES-256-GCM 暗号化済み（長いため Text 型）
  refreshToken        String?     // AES-256-GCM 暗号化済み
  tokenExpiry         DateTime?
  spreadsheetId       String?             // ライセンスキー用スプレッドシートID
  sheetName           String    @default("ライセンスキー")
  keyColumn           String    @default("A")
  storeSpreadsheetId  String?             // 店舗マスター用スプレッドシートID
  storeSheetName      String    @default("店舗マスター")
  storeColumnMapping  String?     // JSON: {"code":"A","name":"B",...}
  inquirySpreadsheetId String?            // お問い合わせ用スプレッドシートID
  inquirySheetName    String    @default("お問い合わせ")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

// サイト全体設定（Google Analytics、楽天APIなど）
model SiteConfig {
  id               String   @id @default(cuid())
  gaTrackingId     String?              // Google Analytics トラッキングID (G-XXXXXXX)
  rakutenAppId     String?              // 楽天商品検索API アプリケーションID
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// 買取相談メモ（顧客が買取希望品を事前に登録）
model PurchaseMemo {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  inquiryId   String?
  inquiry     Inquiry? @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  title       String                      // 品名・タイトル
  description String?             // 詳細説明
  imageUrls   String   @default("[]")   // JSON配列: 画像URL[]
  status      String   @default("pending") // pending, reviewed, completed
  storeNote   String?             // 店舗からのコメント
  aiAppraisal   String?  @db.Text  // AI査定結果(JSON)
  aiAppraisalAt DateTime?           // AI査定実行日時
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([inquiryId])
}

// 宅配買取送付履歴
model DeliveryShipment {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shipmentNumber String   @unique  // "HD-YYYYMM-NNNN"
  shipmentMonth  String            // "YYYY-MM"
  description    String?
  imageUrls      String   @default("[]")        // 箱の中の写真
  trackingImageUrls String @default("[]")       // 発送伝票の写真
  purchaseAmount Int?     // 査定金額（店舗が更新）
  status         String   @default("draft")     // draft|registered|shipped|received|appraised|transferred
  storeNote      String?
  transferredAt  DateTime? // 振込済み日時（店舗が更新）
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([shipmentMonth])
}

// 見積書（買取金額・請求金額・有効期限を記録。署名・顧客情報は不要）
model Estimate {
  id              String        @id @default(cuid())
  visitScheduleId String?       @unique
  visitSchedule   VisitSchedule? @relation(fields: [visitScheduleId], references: [id], onDelete: SetNull)
  dealId          String?       @unique         // 案件への紐づけ（再ペアレント。1案件1見積）
  deal            Deal?         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  purchaseAmount  Int                         // 買取金額（円）
  billingAmount   Int                         // 請求金額（円）
  validUntil      DateTime                    // 見積有効期限
  staffName       String                      // 見積担当者
  memberId        String?                     // 見積を作成した店舗メンバー（帰属）
  member          StoreMember?  @relation(fields: [memberId], references: [id], onDelete: SetNull)
  customerEmail   String?                     // 送信先メールアドレス（記録用）
  pdfBase64       String?       @db.Text       // 買取見積PDF（base64）
  invoicePdfBase64 String?      @db.Text       // 請求見積PDF（base64）
  emailSentAt     DateTime?                   // メール送信日時
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([memberId])
}

// 売買契約書（署名・PDF保存）
model SalesContract {
  id                    String        @id @default(cuid())
  visitScheduleId       String?       @unique
  visitSchedule         VisitSchedule? @relation(fields: [visitScheduleId], references: [id], onDelete: SetNull)
  dealId                String?       @unique     // 案件への紐づけ（再ペアレント。1案件1契約）
  deal                  Deal?         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  signatureData         String        // 売買契約への顧客署名（base64 PNG data URL）
  invoiceSignatureData  String?       // 請求書への顧客署名（base64 PNG data URL）
  pdfBase64             String?       @db.Text  // 売買契約書PDF（base64）
  invoicePdfBase64      String?       @db.Text  // 請求書PDF（base64）
  customerEmail         String?       // 送信先メールアドレス（記録用）
  emailSentAt           DateTime?     // メール送信日時
  agreedAt              DateTime      @default(now())
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
}

// パスワードリセットトークン
model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  email     String
  userType  String    // "store" | "customer"
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// マジックリンク（顧客契約書閲覧用）
model MagicLink {
  id         String    @id @default(cuid())
  token      String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  contractId String?   // optional: link to specific contract/visit
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
}

// パスキー（WebAuthn）認証情報
model PasskeyCredential {
  id           String    @id @default(cuid())
  credentialId String    @unique // base64url形式のクレデンシャルID
  publicKey    Bytes     // COSE公開鍵
  counter      BigInt    @default(0) // クローン検知用署名カウンタ
  transports   String?   // JSON配列文字列 例: ["internal","hybrid"]
  deviceType   String?   // "singleDevice" | "multiDevice"
  backedUp     Boolean   @default(false) // クラウド同期されているか
  deviceName   String?   // ユーザーが付ける表示名（例: 事務所のPC）
  userType     String    // "admin" | "store" | "storeMember"
  userId       String    // 対象テーブルのID（多態参照）
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([userType, userId])
}

// WebAuthn チャレンジ（ワンタイム・リプレイ防止）
model WebAuthnChallenge {
  id        String    @id @default(cuid())
  challenge String    @unique // base64url
  type      String    // "registration" | "authentication"
  userType  String?   // 登録時のみ設定
  userId    String?   // 登録時のみ設定
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// パスキー検証済みワンタイムログイントークン（NextAuthセッション発行の橋渡し）
model PasskeyLoginToken {
  id           String    @id @default(cuid())
  tokenHash    String    @unique // sha256(token) のみ保存
  userType     String    // "admin" | "store" | "storeMember"
  userId       String
  credentialId String    // 使用された PasskeyCredential.credentialId
  expiresAt    DateTime  // 発行から60秒
  usedAt       DateTime?
  createdAt    DateTime  @default(now())
}

// デバイスセッション（長期セッションの失効管理）
model DeviceSession {
  id           String    @id @default(cuid())
  userType     String    // "admin" | "store" | "storeMember"
  userId       String
  memberId     String?   // storeMember の場合の StoreMember.id
  credentialId String?   // パスキーログイン時の PasskeyCredential.credentialId
  loginMethod  String    // "password" | "passkey"
  ip           String?
  userAgent    String?
  lastSeenAt   DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([userType, userId])
}

// 店舗一括編集のプレゼンス（誰がどの店舗を編集中かの表示用。ロックはしない）
model StoreEditPresence {
  id         String   @id @default(cuid())
  adminId    String   // Admin.id
  adminName  String
  storeId    String?  // null = 一括編集モーダルを開いている（特定店舗はまだ編集していない）
  lastSeenAt DateTime @default(now())

  @@index([adminId])
  @@index([lastSeenAt])
}

// 店舗お問い合わせ
model Inquiry {
  id              String   @id @default(cuid())
  storeId         String
  store           Store    @relation(fields: [storeId], references: [id])
  name            String   // 氏名
  furigana        String   // フリガナ
  phone           String   // 電話番号
  email           String?  // メールアドレス
  postalCode      String?  // 郵便番号
  address         String   // 住所
  inquiryType     String   // 申込み内容: assessment/purchase/estate/other
  details         String?  @db.Text // 相談内容詳細
  userId          String?  // 自動作成された顧客のID
  user            User?    @relation(fields: [userId], references: [id])
  status          String   @default("new") // new/contacted/completed
  purchaseMemos   PurchaseMemo[]
  deal            Deal?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([storeId])
  @@index([status])
}

// 案件（買取案件・商談）
model Deal {
  id          String    @id @default(cuid())
  userId      String                       // 顧客（必須）
  user        User      @relation(fields: [userId], references: [id])
  storeId     String?                      // 担当店舗（問い合わせ由来は必ず有り／手動作成は任意）
  store       Store?    @relation(fields: [storeId], references: [id])
  inquiryId   String?   @unique            // 由来の問い合わせ（1案件:1問い合わせ）
  inquiry     Inquiry?  @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  detail      String?   @db.Text           // 買取内容などの自由記述メモ（タイトルなし）
  status      String    @default("inquiry") // inquiry/visit_decided/estimate_only/contract/completed/lost
  category    String    @default("purchase") // 案件カテゴリー: purchase(買取)/akikuru(アキクル)/ecotoku(エコトク)
  occurredAt  DateTime  @default(now())     // 案件発生日（手動設定可・既定は作成日時）
  createdByType String?                     // 作成者種別（store/admin/superadmin/hr/customer/partner）
  createdById   String?                     // 作成者ID（Store.id / Admin.id など・スナップショット）
  createdByName String?                     // 作成者名（スナップショット）
  memberId      String?                     // 作成した店舗メンバー（帰属）
  member        StoreMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  purchaseAmount Int?                       // 買取金額合計（案件配下の買取品目合計×上乗せ・自動計算）
  billingAmount  Int?                       // 請求金額合計（案件配下の請求項目合計・自動計算）
  purchaseUpliftPercent Int @default(0)     // 買取金額の上乗せ率（0/10/15%。キャンペーン等）
  preConsentSignature String? @db.Text      // 事前同意の署名画像（base64）
  preConsentAt        DateTime?             // 事前同意日時
  paperContractImages String  @default("[]") // 紙で作成した売買契約書の写真URL（JSON配列）
  visitSchedules VisitSchedule[]           // 1案件:N訪問予定（任意リンク）
  purchaseItems  PurchaseItem[]            // 案件配下の買取品目
  workItems      WorkItem[]                // 案件配下の請求項目
  salesContract  SalesContract?            // 案件の売買契約書（1:1）
  estimate       Estimate?                 // 案件の見積（1:1）
  recordings     DealRecording[]           // 会話の録音音声（AI文字起こし・要約）
  akikuruInvoice AkikuruInvoice?           // アキクル案件のStripe請求書（1:1）
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([storeId])
  @@index([status])
  @@index([category])
  @@index([memberId])
}

// 案件に紐づく会話録音（音声）。AIで文字起こし＋要約を非同期生成する。
model DealRecording {
  id            String    @id @default(cuid())
  dealId        String
  deal          Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  audioUrl      String    @db.Text          // Vercel Blob の音声URL
  fileName      String?
  mimeType      String?
  fileSize      Int?                        // バイト
  durationSec   Int?
  status        String    @default("pending") // pending | processing | done | error
  transcript    String?   @db.Text          // 話者ラベル付き文字起こし
  summary       String?   @db.Text          // JSON文字列 { overview, requests[], important[], nextActions[] }
  error         String?   @db.Text
  attempts      Int       @default(0)
  uploadedByType String?
  uploadedById   String?
  uploadedByName String?
  createdAt     DateTime  @default(now())
  processedAt   DateTime?
  updatedAt     DateTime  @updatedAt

  @@index([dealId])
  @@index([status])
}

// 在庫（店舗の販売商品。買取品目から変換可。将来のマーケット自動出品を見据えた設計）
model InventoryItem {
  id                   String   @id @default(cuid())
  storeId              String                          // 所有店舗（必須）
  store                Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sourcePurchaseItemId String?  @unique                // 変換元の買取品目（1:1・二重変換防止）
  sourcePurchaseItem   PurchaseItem? @relation(fields: [sourcePurchaseItemId], references: [id], onDelete: SetNull)
  // 商品・出品データ
  title                String                          // 商品名（必須）
  description          String   @default("") @db.Text
  categoryName         String   @default("")
  brand                String?
  condition            String   @default("no_noticeable_damage") // メルカリ6段階のキー
  costPrice            Int                             // 仕入れ値（円・必須）
  listingPrice         Int?                            // 販売価格（円）
  quantity             Int      @default(1)
  managementCode       String?                         // 管理コード/SKU
  imageUrls            String   @default("[]")         // JSON配列（最大10）
  janCode              String?
  // 配送・寸法（メルカリ出品向け）
  weightGrams          Int?
  sizeW                Int?
  sizeH                Int?
  sizeD                Int?
  shippingPayer        String   @default("seller")     // seller | buyer
  shippingMethod       String?
  shippingFromPrefecture String?
  shippingDays         String?                         // "1-2" | "2-3" | "4-7"
  // ライフサイクル
  status               String   @default("draft")      // draft|ready|listed|sold|archived
  listedAt             DateTime?
  soldPrice            Int?
  soldAt               DateTime?
  note                 String   @default("") @db.Text
  listings             MarketplaceListing[]
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([storeId])
  @@index([status])
  @@index([storeId, status])
}

// マーケットプレイス出品状態（在庫1:Nマーケット。将来のAPI同期状態を保持）
model MarketplaceListing {
  id              String   @id @default(cuid())
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  marketplace     String                       // "mercari" | "yahoo" | ...
  externalId      String?                      // マーケット側の商品ID
  url             String?  @db.Text
  listingStatus   String   @default("pending")  // pending|listed|sold|error|cancelled
  listedAt        DateTime?
  soldAt          DateTime?
  rawResponse     String?  @db.Text            // API生レスポンス(JSON)
  errorMessage    String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([inventoryItemId, marketplace])
  @@index([inventoryItemId])
  @@index([marketplace, listingStatus])
}

// 店舗→運営の不具合報告
model BugReport {
  id           String   @id @default(cuid())
  storeId      String
  store        Store    @relation(fields: [storeId], references: [id])
  reporterName String?            // 報告者の名前（StoreMember 名 or 店舗名）
  title        String              // 件名
  category     String              // 種別: system/ui/operation/other
  details      String   @db.Text   // 詳細
  imageUrls    String   @default("[]") // JSON 配列
  status       String   @default("open") // open/in_progress/resolved
  comments     BugReportComment[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([storeId])
  @@index([status])
}

// 不具合報告のコメント（店舗←→運営のやりとり）
model BugReportComment {
  id          String    @id @default(cuid())
  bugReportId String
  bugReport   BugReport @relation(fields: [bugReportId], references: [id], onDelete: Cascade)
  authorType  String                       // "store" | "admin"
  authorName  String?
  body        String    @db.Text
  imageUrls   String    @default("[]")     // JSON 配列
  createdAt   DateTime  @default(now())

  @@index([bugReportId])
}

// ログイン試行回数制限（DB実装: サーバーレス対応）
model LoginAttempt {
  id           String    @id @default(cuid())
  key          String    @unique  // "role:email"
  failCount    Int       @default(0)
  firstFailAt  DateTime  @default(now())
  blockedUntil DateTime?
  updatedAt    DateTime  @updatedAt

  @@index([key])
}

// 汎用レート制限（問い合わせフォームなど）
model RateLimit {
  id           String    @id @default(cuid())
  key          String    @unique  // "inquiry:ip:1.2.3.4" / "inquiry:email:foo@bar"
  count        Int       @default(0)
  windowStart  DateTime  @default(now())
  blockedUntil DateTime?
  updatedAt    DateTime  @updatedAt

  @@index([key])
}

// メール送信キュー（SMTPの遅延・失敗対応）
model EmailQueue {
  id          String    @id @default(cuid())
  type        String    // "inquiryAutoReply" | "storeInquiry" | ...
  payload     String    @db.Text  // JSON-serialized params
  status      String    @default("pending")  // pending | processing | sent | failed
  attempts    Int       @default(0)
  lastError   String?   @db.Text
  scheduledAt DateTime  @default(now())
  sentAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, scheduledAt])
}

// iPhone中古相場価格（Gemini AIによる月次取得）
model PhoneMarketPrice {
  id        String   @id @default(cuid())
  model     String   // "iPhone 15 Pro"
  series    String   // "iPhone 15"
  storage   String   // "128GB"
  gradeA    Int?     // A評価（美品）の相場（円）
  gradeB    Int?     // B評価（並品）の相場（円）
  gradeC    Int?     // C評価（難あり）の相場（円）
  source    String   @default("gemini")
  fetchedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([model, storage])
  @@index([series])
}

// お知らせカテゴリ
model AnnouncementCategory {
  id            String         @id @default(cuid())
  name          String         @unique
  color         String         @default("#6B7280")
  icon          String         @default("megaphone") // フラットアイコンのキー（src/components/announcement/categoryIcons.tsx）
  sortOrder     Int            @default(0)
  announcements Announcement[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

// 本部からのお知らせ
model Announcement {
  id          String    @id @default(cuid())
  title       String
  content     String    @db.Text
  category    String    @default("general") // レガシー互換
  categoryId  String?
  announcementCategory AnnouncementCategory? @relation(fields: [categoryId], references: [id])
  priority    String    @default("normal") // "normal" | "high" | "urgent"
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  adminId     String
  admin       Admin     @relation(fields: [adminId], references: [id])
  reads       AnnouncementRead[]
  reactions   AnnouncementReaction[]
  comments    AnnouncementComment[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isPublished, publishedAt])
  @@index([adminId])
  @@index([categoryId])
}

// お知らせ既読管理
model AnnouncementRead {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  storeId        String
  store          Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@unique([announcementId, storeId])
  @@index([storeId])
}

// リリースノート（運営=sysadmin → 店舗・管理ポータルへのプロダクト更新告知）
// 本部→店舗の業務連絡である Announcement とは別軸で管理する。
model ReleaseNote {
  id          String    @id @default(cuid())
  version     String?   // 例: "v1.4.0"（任意）
  title       String
  content     String    @db.Text  // TipTap が出力する HTML
  category    String    @default("feature") // "feature" | "improvement" | "fix" | "notice"
  targetStore Boolean   @default(true)  // 店舗ポータルに配信
  targetAdmin Boolean   @default(true)  // 管理ポータルに配信
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  authorId    String?   // 発信者（Admin.role='sysadmin'）。削除時は null
  author      Admin?    @relation("ReleaseNoteAuthor", fields: [authorId], references: [id])
  reads       ReleaseNoteRead[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isPublished, publishedAt])
  @@index([authorId])
}

// リリースノート既読管理（店舗単位／管理者個人単位の両対応）
model ReleaseNoteRead {
  id            String      @id @default(cuid())
  releaseNoteId String
  releaseNote   ReleaseNote @relation(fields: [releaseNoteId], references: [id], onDelete: Cascade)
  readerType    String      // "admin" | "store"
  readerId      String      // adminId / storeId
  readAt        DateTime    @default(now())

  @@unique([releaseNoteId, readerType, readerId])
  @@index([readerType, readerId])
}

// 研修動画カテゴリ
model VideoCategory {
  id        String          @id @default(cuid())
  name      String          @unique
  sortOrder Int             @default(0)
  videos    TrainingVideo[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

// 研修動画
model TrainingVideo {
  id            String         @id @default(cuid())
  title         String
  description   String?        @db.Text
  videoUrl      String                     // 動画ファイルURL（Vercel Blob）
  thumbnailUrl  String?                    // サムネイル画像URL
  fileSize      Int?                       // ファイルサイズ（バイト）
  categoryId    String
  category      VideoCategory  @relation(fields: [categoryId], references: [id])
  isPublished   Boolean        @default(false)
  publishedAt   DateTime?
  sortOrder     Int            @default(0)
  summary       String?        @db.Text   // AI要約コンテンツ
  summaryAt     DateTime?                  // 要約生成日時
  keyPoints     String?        @db.Text   // 重要ポイント(JSON配列)
  adminId       String
  admin         Admin          @relation(fields: [adminId], references: [id])
  views         TrainingVideoView[]
  likes         TrainingVideoLike[]
  comments      TrainingVideoComment[]
  favorites     TrainingVideoFavorite[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([categoryId])
  @@index([isPublished])
  @@index([adminId])
}

// 研修動画への「いいね（Good）」（店舗単位でトグル）
model TrainingVideoLike {
  id              String        @id @default(cuid())
  trainingVideoId String
  trainingVideo   TrainingVideo @relation(fields: [trainingVideoId], references: [id], onDelete: Cascade)
  storeId         String
  createdAt       DateTime      @default(now())

  @@unique([trainingVideoId, storeId])
  @@index([trainingVideoId])
}

// 研修動画へのコメント（店舗／本部）
model TrainingVideoComment {
  id              String        @id @default(cuid())
  trainingVideoId String
  trainingVideo   TrainingVideo @relation(fields: [trainingVideoId], references: [id], onDelete: Cascade)
  authorType      String        // "store" | "admin"
  storeId         String?       // 店舗コメント時の店舗ID
  memberId        String?       // 店舗メンバー個人（任意）
  authorName      String
  body            String        @db.Text
  createdAt       DateTime      @default(now())

  @@index([trainingVideoId])
}

// 研修動画のお気に入り（店舗単位）
model TrainingVideoFavorite {
  id              String        @id @default(cuid())
  trainingVideoId String
  trainingVideo   TrainingVideo @relation(fields: [trainingVideoId], references: [id], onDelete: Cascade)
  storeId         String
  createdAt       DateTime      @default(now())

  @@unique([trainingVideoId, storeId])
  @@index([trainingVideoId])
  @@index([storeId])
}

// 研修動画の店舗別視聴ステータス（店舗×動画でユニーク、再生回数を保持）
model TrainingVideoView {
  id              String        @id @default(cuid())
  trainingVideoId String
  trainingVideo   TrainingVideo @relation(fields: [trainingVideoId], references: [id], onDelete: Cascade)
  storeId         String
  store           Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  playCount       Int           @default(0)
  firstViewedAt   DateTime      @default(now())
  lastViewedAt    DateTime      @default(now())

  @@unique([trainingVideoId, storeId])
  @@index([storeId])
  @@index([trainingVideoId])
}

// コミュニティスレッド
model CommunityThread {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  imageUrls String   @default("[]") @db.Text  // JSON配列: 画像URL[]（最大3枚）
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  isPinned  Boolean  @default(false)
  replies   CommunityReply[]
  reactions CommunityReaction[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId])
  @@index([createdAt])
}

// スレッド返信
model CommunityReply {
  id        String          @id @default(cuid())
  threadId  String
  thread    CommunityThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  content   String          @db.Text
  storeId   String
  store     Store           @relation(fields: [storeId], references: [id])
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([threadId])
  @@index([storeId])
}

// リアクション（スレッドに対する絵文字リアクション）
model CommunityReaction {
  id        String          @id @default(cuid())
  threadId  String
  thread    CommunityThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  emoji     String
  storeId   String
  store     Store           @relation(fields: [storeId], references: [id])
  createdAt DateTime        @default(now())

  @@unique([threadId, storeId, emoji])
  @@index([threadId])
}

// 訪問リクエスト（顧客からの訪問希望）
model VisitRequest {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId         String
  store           Store    @relation(fields: [storeId], references: [id])
  requestedBy     String   @default("customer") // "customer" | "store"
  candidate1Date  DateTime
  candidate1Start String?
  candidate1End   String?
  candidate2Date  DateTime
  candidate2Start String?
  candidate2End   String?
  candidate3Date  DateTime
  candidate3Start String?
  candidate3End   String?
  status          String   @default("pending") // pending, approved, counter_proposed, customer_accepted, customer_declined, cancelled
  approvedCandidate Int?
  counterDate     DateTime?
  counterStart    String?
  counterEnd      String?
  storeNote       String?
  customerNote    String?
  visitScheduleId String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([storeId])
  @@index([status])
}

// 汎用フォームビルダー
model Form {
  id               String           @id @default(cuid())
  slug             String           @unique
  title            String
  description      String?          @db.Text
  schema           String           @db.Text  // JSON文字列: FormField[]
  status           String           @default("draft") // draft | published | closed
  notifyEmails     String?          // カンマ区切りメールアドレス
  successMessage   String?          @db.Text
  sheetWebhookUrl  String?          @db.Text
  recaptchaEnabled Boolean          @default(true)
  // 回答から顧客を自動作成する設定
  customerCreate   Boolean          @default(false)
  customerType     String?          // 主タイプ "visit" | "delivery" | "regular" | "akikuru"
  customerTypes    String?          // JSON配列（複数可）
  customerFieldMap String?          @db.Text  // JSON: { name?, furigana?, email?, phone?, address?, postalCode? } → fieldId
  customerStoreId  String?
  customerStore    Store?           @relation("FormCustomerStore", fields: [customerStoreId], references: [id], onDelete: SetNull)
  // 外部API送信（汎用Webhook）設定
  externalApiEnabled      Boolean  @default(false)
  externalApiUrl          String?  @db.Text  // 送信先URL
  externalApiKeyEnc       String?  @db.Text  // API-Key（AES-256-GCM暗号化）。{{API_KEY}} で参照
  externalApiHeaders      String?  @db.Text  // JSON: カスタムヘッダー（{{API_KEY}} 置換可）
  externalApiStaticFields String?  @db.Text  // JSON: 固定送信フィールド（{{API_KEY}} 置換可）
  externalApiFieldMap     String?  @db.Text  // JSON: { "<fieldId|$id|$submittedAt>": "出力キーパス" }
  externalApiNotifyEmails String?  @db.Text  // 送信成功後の通知先（カンマ区切り）
  createdById      String
  createdBy        Admin            @relation(fields: [createdById], references: [id])
  submissions      FormSubmission[]
  linkPartnerForms LinkPartnerForm[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([status])
  @@index([createdById])
  @@index([customerStoreId])
}

// LINE チャネル設定（管理ポータルから複数アカウントを管理）
model LineChannel {
  id                 String        @id @default(cuid())
  name               String                        // 管理用の表示名
  channelId          String        @unique          // LINE Channel ID
  channelSecret      String        @db.Text         // AES-256-GCM 暗号化
  channelAccessToken String        @db.Text         // AES-256-GCM 暗号化
  isActive           Boolean       @default(true)
  storeId            String?                        // 紐付け店舗（任意）
  store              Store?        @relation(fields: [storeId], references: [id], onDelete: SetNull)
  lineUsers          LineUser[]
  messages           LineMessage[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([storeId])
}

// LINE ユーザー（Webhook 経由でメッセージを送ってきたユーザー）
model LineUser {
  id            String        @id @default(cuid())
  lineUserId    String                             // LINE の userId (U...)
  displayName   String
  pictureUrl    String?       @db.Text
  lineChannelId String
  lineChannel   LineChannel   @relation(fields: [lineChannelId], references: [id], onDelete: Cascade)
  userId        String?                            // 既存顧客との紐付け（任意）
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages      LineMessage[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([lineUserId, lineChannelId])
  @@index([lineChannelId])
  @@index([userId])
}

// LINE メッセージ履歴
model LineMessage {
  id            String      @id @default(cuid())
  lineUserId    String
  lineUser      LineUser    @relation(fields: [lineUserId], references: [id], onDelete: Cascade)
  lineChannelId String
  lineChannel   LineChannel @relation(fields: [lineChannelId], references: [id], onDelete: Cascade)
  direction     String                            // "inbound" | "outbound"
  messageType   String                            // "text" | "image" | "sticker" | "other"
  content       String?     @db.Text              // テキスト本文
  imageUrl      String?     @db.Text              // 画像の場合
  lineMessageId String?     @unique               // LINE 側のメッセージID（重複防止）
  status        String      @default("sent")      // "sent" | "failed"
  sentAt        DateTime
  readAt        DateTime?
  createdAt     DateTime    @default(now())

  @@index([lineUserId])
  @@index([lineChannelId])
  @@index([sentAt])
}

// フォーム回答
model FormSubmission {
  id             String    @id @default(cuid())
  formId         String
  form           Form      @relation(fields: [formId], references: [id], onDelete: Cascade)
  data           String    @db.Text  // JSON文字列: { [fieldId]: value }
  ipAddress      String?
  userAgent      String?   @db.Text
  sheetSyncedAt  DateTime?
  sheetSyncError String?   @db.Text
  // 外部API送信の状態
  externalApiPushedAt DateTime?
  externalApiError    String?   @db.Text
  // 自動作成された顧客（customerCreate=true 時）
  userId         String?
  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())

  @@index([formId, createdAt])
  @@index([userId])
}

// 備品（社内商品）
model Product {
  id            String           @id @default(cuid())
  name          String
  purchasePrice Int              // 仕入れ価格（円）
  sellingPrice  Int              // 販売価格（円）
  stock         Int              @default(0)  // hasVariants=false 時の在庫
  minLot        Int              @default(1)  // 最低発注数（最低ロット）
  sortOrder     Int              @default(0)  // 表示順（ドラッグ＆ドロップで設定）
  hasVariants   Boolean          @default(false)
  imageUrl      String?          @db.Text  // 商品画像URL（Vercel Blob）
  supplierUrl   String?          @db.Text
  supplierEmail String?
  supplierNote  String?          @db.Text
  variants      ProductVariant[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model ProductVariant {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sizeName     String
  stock        Int      @default(0)
  sellingPrice Int?     // null の場合は Product.sellingPrice を使う
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([productId])
}

// 社員情報
model Employee {
  id                          String    @id @default(cuid())
  employeeNumber              String    @unique
  lastName                    String
  firstName                   String
  lastNameKana                String?
  firstNameKana               String?
  hireDate                    DateTime?
  hireType                    String?   // 中途/新卒/その他
  employmentType              String?   // 正社員/契約/パート/業務委託
  department                  String?
  jobTitle                    String?
  jobCategory                 String?
  jobDescription              String?   @db.Text
  resignDate                  DateTime?
  resignType                  String?
  gender                      String?
  workEmail                   String?
  workPhone                   String?
  dateOfBirth                 DateTime?
  address                     String?   @db.Text
  emergencyContact            String?   @db.Text
  personalPhone               String?
  // 暗号化フィールド（AES-256-GCM、@/lib/encrypt）
  basicPensionNumberEnc        String?   @db.Text
  healthInsuranceNumberEnc     String?   @db.Text
  employmentInsuranceNumberEnc String?   @db.Text
  residenceCardNumberEnc       String?   @db.Text
  payrollBankInfoEnc           String?   @db.Text
  qualifications              String?   @db.Text
  resumeDriveUrl              String?   @db.Text
  businessCardDriveUrl        String?   @db.Text
  profilePhotoDriveUrl        String?   @db.Text
  maritalStatus               String?   // single / married
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@index([department])
  @@index([resignDate])
}

// セールスパートナー（紹介営業担当者）
model SalesPartner {
  id           String                       @id @default(cuid())
  name         String
  email        String                       @unique
  password     String?                      // 招待受諾時に設定。未受諾はnull
  isActive     Boolean                      @default(true)
  invitedById  String?                      // 招待発行した Admin
  invitedBy    Admin?                       @relation("SalesPartnerInvitedBy", fields: [invitedById], references: [id])
  acceptedAt   DateTime?                    // 招待受諾日時
  invitations  SalesPartnerInvitation[]
  customerNotes SalesPartnerCustomerNote[]
  customerImports PartnerCustomerImport[]
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @updatedAt
}

// セールスパートナー招待リンク（管理者が発行）
model SalesPartnerInvitation {
  id             String        @id @default(cuid())
  token          String        @unique
  email          String                                       // 招待先メールアドレス
  name           String?                                       // 想定名（省略可）
  expiresAt      DateTime
  usedAt         DateTime?
  createdById    String                                        // 発行した Admin
  createdBy      Admin         @relation("SalesPartnerInvCreatedBy", fields: [createdById], references: [id])
  salesPartnerId String?                                       // 受諾後にセット
  salesPartner   SalesPartner? @relation(fields: [salesPartnerId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())

  @@index([email])
}

// セールスパートナー独自の顧客メモ・タグ
model SalesPartnerCustomerNote {
  id             String       @id @default(cuid())
  salesPartnerId String
  salesPartner   SalesPartner @relation(fields: [salesPartnerId], references: [id], onDelete: Cascade)
  userId         String                                         // 対象顧客
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  note           String?      @db.Text
  tag            String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([salesPartnerId, userId])
  @@index([userId])
}

// セールスパートナーによる顧客CSVインポート履歴
model PartnerCustomerImport {
  id            String       @id @default(cuid())
  partnerId     String
  partner       SalesPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  fileName      String
  totalRows     Int                                              // ヘッダー除くデータ行数
  createdCount  Int                                              // 新規作成行数
  updatedCount  Int                                              // 更新行数
  errorCount    Int                                              // エラー行数
  errors        Json?                                            // [{row, licenseKey?, message}]
  createdAt     DateTime     @default(now())

  @@index([partnerId])
  @@index([createdAt])
}

// ============================================================
// 備品発注 + システム管理者画面
// ============================================================

// 本部の備品決済アカウント（Stripe顧客）= シングルトン運用（id="default"）
model SupplyBillingAccount {
  id               String   @id @default("default")
  stripeCustomerId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// 月額システム利用料の設定（sysadminが店舗ごとに設定）
model SystemFeeSetting {
  id            String   @id @default(cuid())
  storeId       String   @unique
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  monthlyAmount Int      @default(0)          // 上書き月額（円・税込）。0 = 対応サービスから自動算出
  isActive      Boolean  @default(false)      // true の店舗のみ毎月課金
  note          String?  @db.Text
  updatedByName String?                       // 最終更新者（sysadmin名）
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// システム利用料の料金項目マスタ（対応サービスごとの月額。sysadminで追加・編集）
model SystemFeeService {
  id            String   @id @default(cuid())
  serviceKey    String   @unique              // Store.supportedServices のキー（kaikuru | akikuru | 追加キー）
  label         String                        // 表示名（買いクル 等）
  monthlyAmount Int      @default(0)          // 月額（円・税込）
  isActive      Boolean  @default(true)       // 無効にすると課金対象から除外
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// 店舗の決済台帳（システム利用料・今後の店舗決済すべてをここに記録）
model StorePayment {
  id                    String    @id @default(cuid())
  storeId               String
  store                 Store     @relation(fields: [storeId], references: [id])
  kind                  String    @default("system_fee")  // system_fee | manual（将来: supply_order 等）
  billingMonth          String?                           // "yyyy-MM"（system_fee の冪等キー）
  description           String                            // 例: システム利用料（2026年8月分）
  amount                Int                               // 円
  status                String    @default("pending")     // pending | paid | failed | no_card
  stripePaymentIntentId String?   @unique
  failureMessage        String?   @db.Text                // 失敗理由（日本語）
  attemptCount          Int       @default(0)
  lastAttemptAt         DateTime?
  paidAt                DateTime?
  receiptNumber         String?   @unique                 // R-YYYYMM-NNNN（初回発行時に採番・不変）
  receiptName           String?                           // 領収書宛名（既定=店舗名・再編集可）
  receiptIssuedAt       DateTime?
  breakdownJson         String?   @db.Text                // 内訳 [{serviceKey,label,amount}]（自動算出時）
  distributionStatus    String    @default("none")        // none | done | partial（分配設定が全platformなら done=保持のみ）
  distributionError     String?   @db.Text
  distributedAt         DateTime?
  transfers             RevenueTransfer[]
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([storeId, kind, billingMonth])                 // 月次課金の二重実行防止
  @@index([storeId, createdAt])
  @@index([status])
  @@index([billingMonth])
}

// 領収書番号の採番カウンタ（シングルトン。$transaction でインクリメント）
model ReceiptCounter {
  id   String @id @default("default")
  last Int    @default(0)
}

// 備品発注（ヘッダー）
model SupplyOrder {
  id                    String            @id @default(cuid())
  orderNumber           String            @unique            // SO-YYYYMM-NNNN
  placedByAdminId       String?                              // 発注した管理者
  placedByName          String
  totalAmount           Int                                  // 合計（円）
  status                String            @default("pending") // 履行: pending(未対応) | ordered(発注済み)
  paymentStatus         String            @default("pending") // pending | paid | failed
  stripePaymentIntentId String?
  note                  String?           @db.Text
  items                 SupplyOrderItem[]
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([status])
  @@index([createdAt])
}

// 発注明細（商品情報はスナップショット保持＝後で商品が変わっても履歴は不変）
model SupplyOrderItem {
  id          String      @id @default(cuid())
  orderId     String
  order       SupplyOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?                                        // 参照（削除時 null 想定）
  variantId   String?
  productName String                                         // スナップショット
  sizeName    String?
  unitPrice   Int
  quantity    Int
  subtotal    Int

  @@index([orderId])
}

// アクセスログ
model AccessLog {
  id        String   @id @default(cuid())
  userType  String                                           // customer/store/admin/sysadmin/partner
  userId    String?
  userName  String?
  memberId  String?                                          // 店舗メンバーとしての操作の場合の StoreMember.id（帰属）
  member    StoreMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  action    String                                           // login など
  ip        String?
  userAgent String?  @db.Text
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userType])
  @@index([memberId])
  @@index([userId, createdAt])
}

// 運用コスト（手動入力、コスト推移・内訳用）
model OperatingCost {
  id          String   @id @default(cuid())
  month       String                                         // YYYY-MM
  category    String                                         // hosting/api/email/labor/stripe/other
  label       String
  amount      Int                                            // 円
  note        String?  @db.Text
  isRecurring Boolean  @default(false)                       // 毎月発生する固定費（自動繰り越し対象）
  source      String   @default("manual")                   // manual | stripe（自動取得分の識別）
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([month])
}

// Stripe Webhook 冪等性ガード
model StripeWebhookEvent {
  id        String   @id                                     // Stripe event id
  type      String
  createdAt DateTime @default(now())
}

// 顧客一覧の保存ビュー（フィルタ・列・ソートのセットをタブとして保存）
model SavedListView {
  id        String   @id @default(cuid())
  portal    String                                           // "admin" | "store"
  ownerId   String                                           // 保存したユーザー（管理者 or 店舗）のセッションID
  name      String
  filters   String   @db.Text                                // 一覧APIクエリ文字列（例: "types=regular&lastVisit=over90"）
  columns   String?  @db.Text                                // 表示列キーのJSON配列
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([portal, ownerId])
}

// 発注先アカウント（仕入先サイトのログイン情報）。パスワードはAES-256-GCMで暗号化保存。
model SupplierAccount {
  id          String   @id @default(cuid())
  name        String                                         // 発注先名（例: ラクスル）
  url         String?  @db.Text                              // ログインURL等
  loginId     String                                         // メールアドレス または ID
  passwordEnc String?  @db.Text                              // 暗号化済みパスワード
  phone       String?
  note        String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ========================================
// 本部⇄店舗チャット
// ========================================

// チャットルーム（1店舗につき1ルーム。本部と当該店舗のやり取りの場）
model ChatRoom {
  id            String          @id @default(cuid())
  storeId       String          @unique
  store         Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  lastMessageAt DateTime?       // 一覧の並び替え用（最新メッセージ日時）
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  messages      ChatMessage[]
  readStates    ChatReadState[]

  @@index([lastMessageAt])
}

// チャットメッセージ（parentId が null ならチャンネル直下、値ありならスレッド返信）
model ChatMessage {
  id             String         @id @default(cuid())
  roomId         String
  room           ChatRoom       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  parentId       String?        // スレッド親メッセージID（null = チャンネル直下）
  parent         ChatMessage?   @relation("ChatThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies        ChatMessage[]  @relation("ChatThread")
  authorType     String         // "admin" | "store"
  authorAdminId  String?
  authorAdmin    Admin?         @relation(fields: [authorAdminId], references: [id], onDelete: SetNull)
  authorMemberId String?
  authorMember   StoreMember?   @relation(fields: [authorMemberId], references: [id], onDelete: SetNull)
  authorName     String         // 表示用スナップショット（本部担当者名 / メンバー名 / 店舗名）
  body           String         @db.Text
  attachments    String         @default("[]") @db.Text  // JSON配列: [{url,name,mimeType,size,kind:"image"|"file"}]
  editedAt       DateTime?      // 編集日時（未編集は null）
  deletedAt      DateTime?      // ソフト削除日時（未削除は null）
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  reactions      ChatReaction[]

  @@index([roomId, createdAt])
  @@index([parentId])
}

// メッセージへの絵文字リアクション（actor 単位でトグル）
model ChatReaction {
  id        String      @id @default(cuid())
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  emoji     String
  actorType String      // "admin" | "store"
  actorId   String      // adminId または memberId（なければ storeId）
  actorName String
  createdAt DateTime    @default(now())

  @@unique([messageId, actorType, actorId, emoji])
  @@index([messageId])
}

// 既読状態（ルーム × 閲覧者ごとの最終既読日時。未読バッジ・既読表示の両方を導出）
model ChatReadState {
  id         String   @id @default(cuid())
  roomId     String
  room       ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  readerType String   // "admin" | "store"
  readerId   String   // adminId / memberId（なければ storeId）
  lastReadAt DateTime @default(now())

  @@unique([roomId, readerType, readerId])
  @@index([roomId])
}

// ========================================
// お知らせへのリアクション・コメント（店舗側）
// ========================================

// お知らせへの絵文字リアクション（店舗単位でトグル）
model AnnouncementReaction {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  emoji          String
  storeId        String       // リアクションした店舗（店舗単位で1絵文字1回）
  createdAt      DateTime     @default(now())

  @@unique([announcementId, storeId, emoji])
  @@index([announcementId])
}

// お知らせへのコメント
model AnnouncementComment {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  authorType     String       // "store" | "admin"
  storeId        String?      // 店舗コメント時の店舗ID
  memberId       String?      // 店舗メンバー個人（任意）
  authorName     String
  body           String       @db.Text
  createdAt      DateTime     @default(now())

  @@index([announcementId])
}

// ========================================
// 知恵袋（店舗間のQ&A）
// ========================================

// 質問
model Question {
  id         String   @id @default(cuid())
  title      String
  body       String   @db.Text
  category   String   // カテゴリ（固定リストから選択）
  storeId    String
  memberId   String?
  authorName String
  isResolved Boolean  @default(false) // 解決済み（ベストアンサー選定で true）
  answers    Answer[]
  reactions  QuestionReaction[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([category])
  @@index([createdAt])
}

// 回答
model Answer {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  body       String   @db.Text
  storeId    String
  memberId   String?
  authorName String
  isBest     Boolean  @default(false) // ベストアンサー
  reactions  AnswerReaction[]
  createdAt  DateTime @default(now())

  @@index([questionId])
}

// 質問へのリアクション（「気になる」等）
model QuestionReaction {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  emoji      String
  storeId    String
  createdAt  DateTime @default(now())

  @@unique([questionId, storeId, emoji])
  @@index([questionId])
}

// 回答へのリアクション（「役に立った」等）
model AnswerReaction {
  id        String   @id @default(cuid())
  answerId  String
  answer    Answer   @relation(fields: [answerId], references: [id], onDelete: Cascade)
  emoji     String
  storeId   String
  createdAt DateTime @default(now())

  @@unique([answerId, storeId, emoji])
  @@index([answerId])
}

// 分析画面のAI生成結果キャッシュ・ログ（インサイト/チャット/レポート/店舗診断ほか）
model AnalyticsAiInsight {
  id          String   @id @default(cuid())
  kind        String   // tab_summary|chat|report|store_diagnosis|forecast|anomalies|explain_point|weekly_digest|store_alerts|text_mining|rfm|whatif
  cacheKey    String   // sha256(kind + 正規化パラメータ)
  tab         String?  // tab_summary のタブ名
  paramsJson  String   @db.Text  // フィルタ条件スナップショット(JSON)
  content     String   @db.Text  // 生成結果(JSON文字列)
  model       String   // 使用モデル名
  createdById String?  // 生成した Admin.id
  createdAt   DateTime @default(now())

  @@index([kind, cacheKey, createdAt])
  @@index([createdAt])
}

// ─── 外部サイト向けアクセス計測（クロスドメイントラッキング） ───

// 計測対象サイト（スクリプトタグ発行単位）
model TrackingSite {
  id        String   @id @default(cuid())
  siteKey   String   @unique          // スクリプトの data-site に入る公開キー
  name      String                    // 表示名（例: OPS銀座LP）
  domains   String   @default("[]")   // 許可ドメインJSON配列（空=全許可）。Originヘッダで照合
  isActive  Boolean  @default(true)
  buttons   TrackingButton[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// コンバージョンボタン（発行ID。電話/LINE等のクリックをCV判定）
model TrackingButton {
  id           String   @id @default(cuid())
  siteId       String
  site         TrackingSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  buttonKey    String   @unique       // "btn_" + 英数8桁。data-track-id に設定
  name         String                 // 例: 電話発信ボタン（ヘッダー）
  kind         String   @default("other") // tel | line | mail | other（表示用）
  isConversion Boolean  @default(true) // CVとして数えるか（false=クリック計測のみ）
  createdAt    DateTime @default(now())

  @@index([siteId])
}

// 訪問者（ブラウザ単位の匿名ID。CV時に顧客Userへ紐付け）
model TrackingVisitor {
  id            String   @id @default(cuid())
  visitorKey    String   @unique      // クライアント生成UUID（localStorage保持）
  firstSeenAt   DateTime @default(now())
  lastSeenAt    DateTime @default(now())
  firstUrl      String?  @db.Text     // 初回ランディングURL
  firstReferrer String?  @db.Text
  userId        String?               // 問い合わせ成立時に紐付く顧客
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessions      TrackingSession[]
  events        TrackingEvent[]

  @@index([userId])
  @@index([lastSeenAt])
}

// セッション（30分無操作で切替。サーバー側で解決）
model TrackingSession {
  id             String   @id @default(cuid())
  visitorId      String
  visitor        TrackingVisitor @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  siteId         String?
  startedAt      DateTime @default(now())
  lastActivityAt DateTime @default(now())
  entryUrl       String   @db.Text
  entryTitle     String?
  referrer       String?  @db.Text
  entryParams    String   @default("{}") @db.Text // ランディングURLの全クエリパラメータJSON（自動検出）
  userAgent      String?  @db.Text
  ipAddress      String?               // 接続元IP（x-forwarded-for先頭。AccessLogと同方式）
  channel        String?               // search|social|ad|referral|direct（referrer+パラメータから自動分類）
  deviceType     String?               // mobile|tablet|desktop（UAから判定）
  browser        String?               // Chrome|Safari|Edge|Firefox等（UAから判定）
  os             String?               // iOS|Android|Windows|macOS等（UAから判定）
  screenSize     String?               // 画面サイズ（例: "390x844"。t.jsが送信）
  language       String?               // ブラウザ言語（navigator.language）
  country        String?               // IP由来の国（x-vercel-ip-country）
  region         String?               // IP由来の都道府県（x-vercel-ip-country-region→県名変換）
  city           String?               // IP由来の市区町村（x-vercel-ip-city）
  isFirstSession Boolean  @default(true) // 新規 vs 再訪の集計用
  hasConversion  Boolean  @default(false) // 集計高速化用の非正規化フラグ
  pageViews      TrackingPageView[]
  events         TrackingEvent[]

  @@index([visitorId, startedAt])
  @@index([startedAt])
  @@index([lastActivityAt])
}

// ページビュー
model TrackingPageView {
  id          String   @id @default(cuid())
  pvKey       String?  @unique        // クライアント生成ID（離脱ビーコンで滞在時間を後追い更新）
  sessionId   String
  session     TrackingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  url         String   @db.Text
  path        String                  // ホスト+パス（クエリ除去。フロー図のノードキー）
  title       String?                 // document.title（フロー図の表示名）
  queryParams String   @default("{}") @db.Text // このPVのクエリパラメータJSON
  durationSec Int?                    // 滞在秒数（離脱ビーコンで更新）
  scrollDepth Int?                    // 最大スクロール到達率 0-100（離脱ビーコンで更新）
  occurredAt  DateTime @default(now())

  @@index([sessionId, occurredAt])
  @@index([occurredAt])
}

// イベント（ボタンクリックCV・フォーム/問い合わせ送信CV）
model TrackingEvent {
  id               String   @id @default(cuid())
  visitorId        String
  visitor          TrackingVisitor @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  sessionId        String?
  session          TrackingSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  type             String            // button_click | inquiry_submit | form_submit
  buttonId         String?           // TrackingButton.id（button_click時）
  inquiryId        String?           // Inquiry.id（inquiry_submit時）
  formSubmissionId String?           // FormSubmission.id（form_submit時）
  storeId          String?           // 問い合わせ先店舗（店舗別集計用の非正規化）
  url              String?  @db.Text // 発生ページ
  isConversion     Boolean  @default(true)
  occurredAt       DateTime @default(now())

  @@index([visitorId, occurredAt])
  @@index([sessionId])
  @@index([type, occurredAt])
  @@index([storeId, occurredAt])
  @@index([occurredAt]) // 期間指定のみの集計（アクセス解析の概要/CV推移）でシーケンシャルスキャンになるのを防ぐ
}

// キャンペーンURLビルダー（パラメータ付きURLの発行・成果の自動追跡）
model TrackingCampaign {
  id        String   @id @default(cuid())
  name      String                    // 例: 7月Instagram広告
  baseUrl   String   @db.Text
  params    String   @db.Text         // 付与パラメータJSON
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// 連携パートナーポータル（外部連携パートナー向け・SalesPartnerとは別系統）
// ============================================================

// 連携パートナー（組織）。管理ポータルから作成し、共有フォームを割り当てる
model LinkPartner {
  id               String                  @id @default(cuid())
  name             String                                       // 組織名
  isActive         Boolean                 @default(true)       // 無効化で全メンバーのログインを遮断
  note             String?                 @db.Text             // 管理者用の内部メモ
  invitedByAdminId String?                                      // 作成した Admin
  invitedByAdmin   Admin?                  @relation("LinkPartnerCreatedByAdmin", fields: [invitedByAdminId], references: [id], onDelete: SetNull)
  members          LinkPartnerMember[]
  forms            LinkPartnerForm[]
  invitations      LinkPartnerInvitation[]
  activityLogs     LinkPartnerActivityLog[]
  statuses         LinkPartnerStatus[]
  recordStatuses   LinkPartnerRecordStatus[]
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
}

// 連携パートナーのログインアカウント（partner_admin / member の2階層）
model LinkPartnerMember {
  id                 String      @id @default(cuid())
  linkPartnerId      String
  linkPartner        LinkPartner @relation(fields: [linkPartnerId], references: [id], onDelete: Cascade)
  name               String
  email              String      @unique                       // グローバル一意（v1: 1人1組織）
  password           String?                                    // 招待受諾/初期発行で設定。未設定はnull
  role               String      @default("member")            // "partner_admin" | "member"
  isActive           Boolean     @default(true)
  mustChangePassword Boolean     @default(false)               // 初期発行アカウントの初回強制変更
  invitedByMemberId  String?                                    // 招待した partner_admin（初代はnull）
  acceptedAt         DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([linkPartnerId])
  @@index([role])
}

// フォーム↔連携パートナー 割当（多対多結合表 = 編集可能な「共有内容」）
model LinkPartnerForm {
  id                String      @id @default(cuid())
  linkPartnerId     String
  linkPartner       LinkPartner @relation(fields: [linkPartnerId], references: [id], onDelete: Cascade)
  formId            String
  form              Form        @relation(fields: [formId], references: [id], onDelete: Cascade)
  assignedByAdminId String?                                     // 割り当てた Admin（監査用スカラー）
  createdAt         DateTime    @default(now())

  @@unique([linkPartnerId, formId])
  @@index([formId])
}

// 連携パートナーのメンバー招待リンク（partner_admin または 管理者が発行）
model LinkPartnerInvitation {
  id                String      @id @default(cuid())
  token             String      @unique
  email             String                                     // 招待先メールアドレス
  name              String?                                    // 想定名（省略可）
  role              String      @default("member")            // 付与ロール
  linkPartnerId     String
  linkPartner       LinkPartner @relation(fields: [linkPartnerId], references: [id], onDelete: Cascade)
  expiresAt         DateTime
  usedAt            DateTime?
  invitedByMemberId String?                                    // 発行した partner_admin（管理者発行時はnull）
  memberId          String?                                    // 受諾後にセット
  createdAt         DateTime    @default(now())

  @@index([email])
  @@index([linkPartnerId])
}

// 連携パートナーの行動ログ（専用テーブル。利用状況ダッシュボードのソース）
model LinkPartnerActivityLog {
  id            String      @id @default(cuid())
  linkPartnerId String
  linkPartner   LinkPartner @relation(fields: [linkPartnerId], references: [id], onDelete: Cascade)
  memberId      String?                                        // 実行メンバー（監査用スカラー）
  memberName    String?                                        // 表示用スナップショット
  action        String                                         // login|invite_member|accept_invite|view_customer|view_inquiry|export_customers|export_inquiries|set_status
  targetType    String?                                        // customer|inquiry|member|form
  targetId      String?
  detail        String?     @db.Text                           // 人間可読の詳細（例: 「未対応 → 対応中」）
  ip            String?
  userAgent     String?     @db.Text
  createdAt     DateTime    @default(now())

  @@index([linkPartnerId, createdAt])
  @@index([memberId])
  @@index([action])
}

// 連携パートナーの対応ステータス定義（パートナーごと・問い合わせ用/顧客用で別セット）
model LinkPartnerStatus {
  id            String      @id @default(cuid())
  linkPartnerId String
  linkPartner   LinkPartner @relation(fields: [linkPartnerId], references: [id], onDelete: Cascade)
  targetType    String                                         // "inquiry" | "customer"
  label         String                                         // 表示名（例: 未対応 / 対応中 / 完了）
  color         String?                                        // バッジ色（任意・HEX等）
  sortOrder     Int         @default(0)
  isActive      Boolean     @default(true)
  assignments   LinkPartnerRecordStatus[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([linkPartnerId, targetType])
}

// レコード（問い合わせ/顧客）への対応ステータス付与（パートナー×対象で一意）
model LinkPartnerRecordStatus {
  id               String             @id @default(cuid())
  linkPartnerId    String
  linkPartner      LinkPartner        @relation(fields: [linkPartnerId], references: [id], onDelete: Cascade)
  targetType       String                                       // "inquiry"(FormSubmission) | "customer"(User)
  targetId         String                                       // submissionId または userId
  statusId         String?                                      // 定義削除時は SetNull（未設定扱い）
  status           LinkPartnerStatus? @relation(fields: [statusId], references: [id], onDelete: SetNull)
  updatedByMemberId String?                                     // 最終更新メンバー（監査用スカラー）
  updatedByName    String?                                      // 表示用スナップショット
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([linkPartnerId, targetType, targetId])
  @@index([linkPartnerId, targetType])
  @@index([statusId])
}

// ============================================================
// 空き家管理案件（アキクル対応店舗の定期管理代行サービス）
// Deal（案件）とは独立した専用モデル群
// ============================================================

// 空き家管理案件
model AkiyaCase {
  id              String    @id @default(cuid())
  userId          String                        // 物件所有者（顧客）
  user            User      @relation(fields: [userId], references: [id])
  storeId         String                        // 担当店舗
  store           Store     @relation(fields: [storeId], references: [id])
  propertyAddress String    @db.Text            // 物件所在地
  startDate       DateTime?                     // 利用開始日
  endDate         DateTime?                     // 利用終了日
  plan            String    @default("standard")     // プラン（akiya-plans.ts: standard/light/premium/mansion）
  status          String    @default("pre_contract") // ステータス（akiya-status.ts: pre_contract/contracting/contracted/cancelled）
  photoUrls       String    @default("[]")      // 物件写真URL JSON配列
  note            String?   @db.Text            // 物件メモ（長文）
  lastVisitedAt   DateTime?                     // 前回訪問日（管理記録の追加で自動更新）
  nextVisitAt     DateTime?                     // 次回訪問日
  // 作成者スナップショット（Deal と同じ流儀）
  createdByType   String?                       // store / admin / superadmin / hr
  createdById     String?
  createdByName   String?
  memberId        String?                       // 作成した店舗メンバー（帰属）
  member          StoreMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  records         AkiyaRecord[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([storeId])
  @@index([status])
  @@index([nextVisitAt])
}

// 管理記録（1案件:N記録。現場スマホから追加）
model AkiyaRecord {
  id          String    @id @default(cuid())
  akiyaCaseId String
  akiyaCase   AkiyaCase @relation(fields: [akiyaCaseId], references: [id], onDelete: Cascade)
  performedAt DateTime  @default(now())     // 管理実行日時
  gpsLat      Float?                        // 記録時GPS（内部向け証跡。取得失敗時は null）
  gpsLng      Float?
  gpsAccuracy Float?                        // 精度（メートル）
  staffName   String?                       // 担当スタッフ名スナップショット
  memberId    String?                       // 担当した店舗メンバー（帰属）
  member      StoreMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  items       AkiyaRecordItem[]
  // 顧客向けレポート（提出するとトークンURLを発行し、顧客メールへ送信する）
  reportToken       String?   @unique       // 閲覧用トークン（提出時に発行・以後不変）
  reportSubmittedAt DateTime?               // レポート提出日時（null = 未提出）
  reportSentTo      String?                 // メール送信先アドレス（スナップショット）
  reportSentAt      DateTime?               // メール送信に成功した日時
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([akiyaCaseId, performedAt])
  @@index([memberId])
}

// 記録×管理項目の明細。項目名・順序はマスタのスナップショット（マスタ変更・削除に耐える）
model AkiyaRecordItem {
  id           String   @id @default(cuid())
  recordId     String
  record       AkiyaRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  itemMasterId String?                      // マスタ削除時は SetNull（表示は itemName で継続）
  itemMaster   AkiyaManagementItem? @relation(fields: [itemMasterId], references: [id], onDelete: SetNull)
  itemName     String                       // 項目名スナップショット（例: 郵便受けの確認）
  sortOrder    Int      @default(0)         // 記録時点のマスタ順スナップショット
  photoUrls    String   @default("[]")      // 写真URL JSON配列
  note         String?  @db.Text            // 項目別テキスト
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([recordId])
  @@index([itemMasterId])
}

// 空き家管理項目マスタ（管理ポータルから追加・編集・並び替え・無効化）
model AkiyaManagementItem {
  id          String   @id @default(cuid())
  name        String   @unique     // 例: 郵便受けの確認
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true) // false = 新規記録のフォームに出さない（既存記録には影響しない）
  recordItems AkiyaRecordItem[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================================
// アキクル案件のStripe請求・分配
// ============================================================

// 分配割合の設定（シングルトン。id は常に "default"）
// 3者（システム管理者/本部/加盟店）の取り分%と、システム管理者/本部の受取先を保持する。
// 受取先 recipientType: "platform"=プラットフォームのStripeアカウント自身が保持（Transferしない）
//                       "connect" =別のConnectアカウントへTransfer（stripeAccountId 必須）
// 加盟店は常に Store.stripeConnectAccountId へのTransfer。
model RevenueShareSetting {
  id                    String   @id @default("default")
  systemPercent         Int      @default(0)    // システム管理者の取り分（%整数。3項目合計100）
  hqPercent             Int      @default(0)    // 本部の取り分
  storePercent          Int      @default(100)  // 加盟店の取り分
  systemRecipientType   String   @default("platform")  // "platform" | "connect"
  systemStripeAccountId String?                         // recipientType=connect のときの acct_...
  hqRecipientType       String   @default("platform")
  hqStripeAccountId     String?
  updatedByAdminId      String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// アキクル案件のStripe請求書（Deal と 1:1）
model AkikuruInvoice {
  id                    String    @id @default(cuid())
  dealId                String    @unique
  deal                  Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  storeId               String?                    // 発行時点の担当店舗
  store                 Store?    @relation(fields: [storeId], references: [id], onDelete: SetNull)
  stripeInvoiceId       String    @unique          // in_...
  stripeCustomerId      String                     // cus_...
  stripePaymentIntentId String?                    // 支払確定時に webhook で記録
  hostedInvoiceUrl      String?   @db.Text         // Stripeホスト決済ページ（カード決済QRの宛先）
  stripeInvoicePdfUrl   String?   @db.Text         // Stripe発行の請求書PDF（参考）
  amount                Int                        // 請求額（円）。発行時スナップショット
  status                String    @default("open") // open | paid | void | uncollectible | payment_failed
  paymentMethod         String?                    // card | customer_balance（銀行振込）
  paidAt                DateTime?
  // 銀行振込先スナップショット（Stripe funding instructions。PDFへの印字内容と一致させて不変保持）
  fundingInstructions   String?   @db.Text         // Stripeレスポンス生JSON
  bankName              String?
  bankBranchName        String?
  bankAccountType       String?                    // 普通 等
  bankAccountNumber     String?
  bankAccountHolder     String?
  // 分配
  distributionStatus    String    @default("pending") // pending | processing | done | partial | failed
  distributionError     String?   @db.Text
  distributedAt         DateTime?
  sharePercentsJson     String?   @db.Text         // 分配時の割合スナップショット {"system":10,"hq":20,"store":70}
  transfers             RevenueTransfer[]
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([storeId])
  @@index([status])
  @@index([distributionStatus])
}

// 分配Transfer台帳（1請求につき system/hq/store の3行を記録。platform保持分もretained_by_platformで記録）
model RevenueTransfer {
  id                       String   @id @default(cuid())
  akikuruInvoiceId         String?             // アキクル請求の分配（どちらか一方が入る）
  akikuruInvoice           AkikuruInvoice? @relation(fields: [akikuruInvoiceId], references: [id], onDelete: Cascade)
  storePaymentId           String?             // システム利用料など店舗決済の分配
  storePayment             StorePayment? @relation(fields: [storePaymentId], references: [id], onDelete: Cascade)
  recipientType            String              // system | hq | store
  recipientStripeAccountId String?             // acct_...（platform保持分は null）
  amount                   Int                 // 円
  stripeTransferId         String?  @unique    // tr_...（platform保持分は null）
  sourceChargeId           String?             // source_transaction に使った charge id
  status                   String   @default("pending") // pending | succeeded | failed | retained_by_platform
  error                    String?  @db.Text
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([akikuruInvoiceId])
  @@index([storePaymentId])
  @@index([status])
}
